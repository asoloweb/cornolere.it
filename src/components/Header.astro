---

import { Image } from 'astro:assets';
import { DIRECTUS_URL, directusItemsUrl } from '../lib/directus';
import { applyTranslation, ui, type SiteLang } from '../lib/i18n';

interface MenuTranslation {
	languages_code?: string | { code?: string } | null;
	label?: string | null;
	custom_href?: string | null;
}

interface MenuItem {
	id?: number | string;
	sort?: number | null;
	label?: string;
	custom_href?: string;
	translations?: MenuTranslation[];
	pages?: { pages_id?: PageItem | number | string }[] | PageItem[];
}

interface Menu {
	id: number;
	slug?: string;
	titolo?: string;
	menu_items?: MenuItem[] | (number | string)[];
}

interface PageTranslation {
	languages_code?: string | { code?: string } | null;
	slug?: string | null;
}

interface PageItem {
	id?: number;
	slug?: string;
	title?: string;
	translations?: PageTranslation[];
}

interface Options {
	logo_dark?: string;
	logo_light?: string;
}

interface Props {
	lang?: SiteLang;
	langSwitchHref?: string;
}

const { lang = 'it', langSwitchHref } = Astro.props;
const uiStrings = ui(lang);
const switchHref = langSwitchHref || (lang === 'en' ? '/' : '/en/');
let logoDarkSrc =
	import.meta.env.PUBLIC_LOGO_DARK || import.meta.env.PUBLIC_LOGO_LIGHT || '/favicon.svg';
const currentPath = Astro.url?.pathname ?? '/';

let menuItems: MenuItem[] = [];

try {
	const optionsUrl = directusItemsUrl('options');
	optionsUrl.searchParams.set('fields', 'logo_dark');
	const optionsResponse = await fetch(optionsUrl);
	if (optionsResponse.ok) {
		const optionsPayload = await optionsResponse.json();
		const options =
			optionsPayload?.data && Array.isArray(optionsPayload.data)
				? optionsPayload.data[0]
				: optionsPayload?.data;
		if (options?.logo_dark) {
			logoDarkSrc = resolveImageSrc(options.logo_dark);
		}
	}

	const url = directusItemsUrl('Menus');
	url.searchParams.set('filter[slug][_eq]', 'menu-principale');
	url.searchParams.set(
		'fields',
		'menu_items.menu_items_id.id,menu_items.menu_items_id.sort,menu_items.menu_items_id.label,menu_items.menu_items_id.custom_href,menu_items.menu_items_id.translations.languages_code,menu_items.menu_items_id.translations.label,menu_items.menu_items_id.translations.custom_href,menu_items.menu_items_id.pages.pages_id.id,menu_items.menu_items_id.pages.pages_id.slug,menu_items.menu_items_id.pages.pages_id.title,menu_items.menu_items_id.pages.pages_id.translations.languages_code,menu_items.menu_items_id.pages.pages_id.translations.slug'
	);
	const response = await fetch(url);
	if (!response.ok) {
		throw new Error(`HTTP ${response.status}: ${response.statusText}`);
	}
	const data = await response.json();
	const menu: Menu | undefined = (data.data || [])[0];
	const rawItems = Array.isArray(menu?.menu_items) ? menu.menu_items : [];
	const itemObjects = rawItems
		.map((item) => {
			if (!item || typeof item !== 'object') return null;
			if ('menu_items_id' in item && item.menu_items_id && typeof item.menu_items_id === 'object') {
				return item.menu_items_id as MenuItem;
			}
			return item as MenuItem;
		})
		.filter((item): item is MenuItem => Boolean(item));

	menuItems = itemObjects.sort((a, b) => (a.sort ?? 999) - (b.sort ?? 999));
} catch (error) {
	console.error('Error fetching menu from Directus:', error);
}

function resolveImageSrc(value: string) {
	if (!value) return '';
	if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('/')) {
		return value;
	}
	return `${DIRECTUS_URL}/assets/${value}`;
}

function getItemPage(item: MenuItem): PageItem | null {
	const rawPages = item.pages;
	if (!rawPages || !Array.isArray(rawPages)) return null;
	const normalizedPages = rawPages
		.map((page) => {
			if (!page) return null;
			if (typeof page === 'object' && 'pages_id' in page) {
				return page.pages_id && typeof page.pages_id === 'object'
					? (page.pages_id as PageItem)
					: null;
			}
			if (typeof page === 'object' && 'slug' in page) {
				return page as PageItem;
			}
			return null;
		})
		.filter((page): page is PageItem => Boolean(page));

	return normalizedPages[0] ?? null;
}

function resolveMenuEntry(item: MenuItem, index: number) {
	const translated = applyTranslation(item as any, lang) as MenuItem;
	const page = getItemPage(item);
	const pageResolved = page ? (applyTranslation(page as any, lang) as PageItem) : null;
	const label = translated.label || pageResolved?.title || page?.title || `Link ${index + 1}`;

	let href = translated.custom_href || item.custom_href || '';
	if (!href) {
		const baseSlug = page?.slug;
		const resolvedSlug = pageResolved?.slug || baseSlug;
		if (lang === 'en' && resolvedSlug && resolvedSlug !== baseSlug) {
			href = `/en/${resolvedSlug}`;
		} else if (baseSlug) {
			href = baseSlug === 'home' ? '/' : `/${baseSlug}`;
		} else {
			href = '/';
		}
	}

	return { label, href };
}

function normalizePath(path: string) {
	if (!path) return '/';
	let cleanPath = path.split('?')[0].split('#')[0];
	if (cleanPath.length > 1 && cleanPath.endsWith('/')) {
		cleanPath = cleanPath.slice(0, -1);
	}
	return cleanPath;
}

function isCurrentMenuItem(href: string) {
	if (!href) return false;
	const base = Astro.url?.origin || 'http://localhost';
	try {
		const url = new URL(href, base);
		return normalizePath(url.pathname) === normalizePath(currentPath);
	} catch {
		return false;
	}
}

function getMenuItemIdClass(item: MenuItem, index: number) {
	const raw = item.id != null ? String(item.id) : `index-${index + 1}`;
	const safe = raw.toLowerCase().replace(/[^a-z0-9_-]+/g, '-');
	return `menu_item_id_${safe}`;
}
---
<div class="TopBar">
	<a target="_blank" href="https://maps.app.goo.gl/Eg3tNKrkvrEuo1jz7">Ca'Cornolere - Castelcucco</a>
	<a href="https://wa.me/393398038658" target="_blank" rel="noopener noreferrer">Scrivici su WhatsApp</a>
	<a href="mailto:info@cornolere.it">info@cornolere.it</a>
</div>
<header class="site-header">
	<nav aria-label={uiStrings.menuAria}>
		<div>
			<a href="/" aria-label="Vai alla home page di Ca'Cornolere">
				<Image
					class="MenuLogo"
					src={logoDarkSrc}
					alt="Ca'Cornolere"
					width={600}
					height={228}
					widths={[316, 600]}
					sizes="(max-width: 1100px) 158px, 316px"
					format="webp"
					loading="eager"
				/>
			</a>
		</div>
		<div class="MenuItemsContainer">
		{menuItems.map((item, index) => {
			const { label, href } = resolveMenuEntry(item, index);
			const isCurrent = isCurrentMenuItem(href);
			const idClass = getMenuItemIdClass(item, index);
			const className = isCurrent
				? `menu_item current_menu_item ${idClass}`
				: `menu_item ${idClass}`;
			return (
				<a href={href} class={className}>
					{label}
				</a>
			);
		})}
		<a
			href={switchHref}
			class="menu_item lang_switcher"
			aria-label={lang === 'it' ? 'Switch to English' : "Passa all'italiano"}
		>
			{uiStrings.switchLangLabel}
		</a>
		</div>
		<button class="hamburger_button mburger" type="button" aria-label={uiStrings.hamburgerAria} aria-expanded="false">
			<b></b>
			<b></b>
			<b></b>
		</button>
	</nav>
</header>

<script is:inline>
(() => {
	const button = document.querySelector('.hamburger_button');
	const menu = document.querySelector('.MenuItemsContainer');
	const header = document.querySelector('.site-header');
	if (!button || !menu) return;
	button.addEventListener('click', () => {
		const isOpen = menu.classList.toggle('is-open');
		button.classList.toggle('is-active', isOpen);
		button.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});

	if (!header) return;

	const setSticky = () => {
		const shouldStick = window.scrollY > 10;
		header.classList.toggle('is-sticky', shouldStick);
		document.body.style.paddingTop = shouldStick ? `${header.offsetHeight}px` : '';
	};

	setSticky();
	window.addEventListener('scroll', setSticky, { passive: true });
	window.addEventListener('resize', setSticky);
})();
</script>
