---
import { Image } from 'astro:assets';
import HeroBlock from '../components/hero_block.astro';
import TitleBlock from '../components/title_block.astro';
import SliderBlock from '../components/slider_block.astro';
import CardsBlock from '../components/cards_block.astro';
import AccordionBlock from '../components/accordion_block.astro';
import GoogleReviewsBlock from '../components/google_reviews_block.astro';
import { DIRECTUS_URL } from '../lib/directus';
import { applyTranslation, ui, type SiteLang } from '../lib/i18n';

type HeroBlockItem = {
	id: number;
	titolo?: string;
	sottotitolo?: string;
	paragrafo?: string;
	label?: string;
	href?: string;
	immagine?: string;
	inverti?: boolean;
	background_color?: string;
};

type SlideItem = {
	id?: number;
	titolo?: string;
	sottotitolo?: string;
	label?: string;
	href?: string;
	immagine?: string;
};

type SliderItem = {
	id?: number;
	titolo?: string;
	slides?: { item?: SlideItem }[] | SlideItem[];
};

type SliderBlockItem = {
	id?: number;
	slider?: SliderItem | number | null;
};

type TitleBlockItem = {
	id: number;
	title?: string;
};

type PageRef = {
	id?: number;
	slug?: string;
};

type SingleCardItem = {
	id?: number;
	titolo_card?: string;
	descrizione?: string;
	immagine?: string;
	href?: string;
	link?: PageRef | number | null;
};

type CardRelation = {
	single_card_id?: SingleCardItem | number | null;
};

type CardsBlockItem = {
	id?: number;
	titolo?: string;
	card?: CardRelation[] | SingleCardItem[];
};

type SingleAccordionItem = {
	id?: number;
	titolo?: string;
	descrizione?: string;
	Espanso?: boolean;
};

type AccordionRelation = {
	single_accordion_id?: SingleAccordionItem | number | null;
};

type AccordionBlockItem = {
	id?: number;
	Titolo?: string;
	titolo?: string;
	label?: string;
	link?: string;
	accordion?: AccordionRelation[] | SingleAccordionItem[];
};

type GoogleReviewsBlockItem = {
	id?: number;
	titolo?: string;
	sottotitolo?: string;
	google_place_id?: string;
	google_business_query?: string;
	numero_recensioni?: number;
	cta_label?: string;
	cta_href?: string;
};

type EditorEntry = {
	collection?: string;
	item?:
		| HeroBlockItem
		| TitleBlockItem
		| SliderBlockItem
		| CardsBlockItem
		| AccordionBlockItem
		| GoogleReviewsBlockItem
		| number
		| string
		| null;
};

type Page = {
	title?: string;
	description?: string;
	Titolo?: string;
	Sottotitolo?: string;
	contenuto?: string;
	hide_page_header?: boolean;
	featured_image?: string;
	editor?: EditorEntry[];
};

interface Props {
	page: Page | null;
	notFoundTitle?: string;
	notFoundMessage?: string;
	showHeader?: boolean;
	lang?: SiteLang;
}

const {
	page,
	notFoundTitle,
	notFoundMessage,
	showHeader = true,
	lang = 'it',
} = Astro.props;

const uiStrings = ui(lang);
const notFoundTitleResolved = notFoundTitle || uiStrings.notFoundTitle;
const notFoundMessageResolved = notFoundMessage || uiStrings.notFoundMessage;

const blocks = Array.isArray(page?.editor) ? page.editor : [];
const pageTitle = page?.title || page?.Titolo || '';
const pageDescription = page?.description || '';
const showPageHeader = page ? showHeader && !page.hide_page_header : false;
const pageHeaderImage = page?.featured_image ? resolveImageSrc(page.featured_image) : '';

function resolveImageSrc(value: string) {
	if (!value) return '';
	if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('/')) {
		return value;
	}
	return `${DIRECTUS_URL}/assets/${value}`;
}

function resolveCollection(block: EditorEntry) {
	if (block.collection) return block.collection;
	const item = block.item;
	if (item && typeof item === 'object') {
		if ('accordion' in item) {
			return 'accordion_block';
		}
		if ('google_place_id' in item || 'google_business_query' in item || 'numero_recensioni' in item) {
			return 'google_reviews_block';
		}
		if ('card' in item) {
			return 'cards_block';
		}
		if ('paragrafo' in item || 'sottotitolo' in item || 'titolo' in item) {
			return 'hero_block';
		}
		if ('slider' in item) {
			return 'slider_block';
		}
		if ('title' in item) {
			return 'title_block';
		}
	}
	return null;
}

function normalizeSlides(input: SliderItem | number | null | undefined, lang: SiteLang = 'it') {
	if (!input || typeof input !== 'object') return [];
	const rawSlides = (input as SliderItem).slides;
	const slidesArray = Array.isArray(rawSlides)
		? rawSlides
		: rawSlides && typeof rawSlides === 'object' && Array.isArray((rawSlides as any).data)
		? (rawSlides as any).data
		: [];
	return slidesArray
		.map((slide) => {
			if (!slide) return null;
			if ('item' in slide && typeof slide.item === 'object') {
				return applyTranslation(slide.item as SlideItem, lang);
			}
			if ('titolo' in slide || 'sottotitolo' in slide || 'immagine' in slide) {
				return applyTranslation(slide as SlideItem, lang);
			}
			return null;
		})
		.filter((slide): slide is SlideItem => Boolean(slide));
}

function normalizeCards(input: CardRelation[] | SingleCardItem[] | undefined, lang: SiteLang = 'it') {
	if (!Array.isArray(input)) return [];
	return input
		.map((entry) => {
			if (!entry || typeof entry !== 'object') return null;
			let card: SingleCardItem | null = null;
			if ('single_card_id' in entry) {
				card =
					entry.single_card_id && typeof entry.single_card_id === 'object'
						? (entry.single_card_id as SingleCardItem)
						: null;
			} else if ('titolo_card' in entry || 'descrizione' in entry || 'immagine' in entry || 'href' in entry) {
				card = entry as SingleCardItem;
			}
			if (!card) return null;
			const translated = applyTranslation(card, lang);
			if (
				lang === 'en' &&
				!translated.href &&
				translated.link &&
				typeof translated.link === 'object'
			) {
				const link = translated.link as PageRef & { translations?: unknown[] };
				const linkEn = applyTranslation(link, 'en');
				const baseSlug = link.slug;
				const enSlug = linkEn.slug;
				if (enSlug && enSlug !== baseSlug) {
					translated.href = `/en/${enSlug}`;
				} else if (baseSlug) {
					translated.href = `/${baseSlug}`;
				}
			}
			return translated;
		})
		.filter((card): card is SingleCardItem => Boolean(card));
}

function normalizeAccordionItems(
	input: AccordionRelation[] | SingleAccordionItem[] | undefined,
	lang: SiteLang = 'it'
) {
	if (!Array.isArray(input)) return [];
	return input
		.map((entry) => {
			if (!entry || typeof entry !== 'object') return null;
			if ('single_accordion_id' in entry) {
				return entry.single_accordion_id && typeof entry.single_accordion_id === 'object'
					? applyTranslation(entry.single_accordion_id as SingleAccordionItem, lang)
					: null;
			}
			if ('titolo' in entry || 'descrizione' in entry) {
				return applyTranslation(entry as SingleAccordionItem, lang);
			}
			return null;
		})
		.filter((accordion): accordion is SingleAccordionItem => Boolean(accordion));
}

function toSlug(value: string) {
	return value
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-+|-+$/g, '');
}

function getBlockDomId(block: EditorEntry, collection: string, index: number) {
	const itemId =
		block.item && typeof block.item === 'object' && 'id' in block.item && block.item.id != null
			? toSlug(String(block.item.id))
			: '';
	const collectionSlug = toSlug(collection) || 'block';
	return itemId
		? `block-${collectionSlug}-${itemId}-${index + 1}`
		: `block-${collectionSlug}-${index + 1}`;
}
---

{page ? (
	<>
		{showPageHeader ? (
			<div class="page_header">
				{pageHeaderImage && (
					<Image
						class="page_header_image"
						src={pageHeaderImage}
						alt=""
						width={1600}
						height={500}
						widths={[768, 1200, 1600]}
						sizes="95vw"
						format="webp"
						loading="eager"
					/>
				)}
				<div class="page_header_inner">
					{pageTitle && <h1 data-aos="fade-up" data-aos-duration="1500">{pageTitle}</h1>}
					{pageDescription && <p data-aos="fade-up" data-aos-duration="1800">{pageDescription}</p>}
				</div>
			</div>
		) : (
			<>
				
			</>
)}
		{page?.contenuto && <div>{page.contenuto}</div>}
		{blocks.map((block, index) => {
			const collection = resolveCollection(block);
			if (!collection) return null;
			if (!block.item || typeof block.item !== 'object') return null;
			let blockContent: any = null;

			switch (collection) {
				case 'hero_block': {
					const hero = applyTranslation(block.item as HeroBlockItem, lang);
					blockContent = (
						<HeroBlock
							titolo={hero.titolo}
							sottotitolo={hero.sottotitolo}
							paragrafo={hero.paragrafo}
							href={hero.href}
							label={hero.label}
							immagine={hero.immagine}
							inverti={hero.inverti}
							background_color={hero.background_color}
						/>
					);
					break;
				}
				case 'title_block': {
					const title = applyTranslation(block.item as TitleBlockItem, lang);
					blockContent = <TitleBlock item={String(title.id ?? '')} titolo={title.title} />;
					break;
				}
				case 'slider_block': {
					const sliderBlock = block.item as SliderBlockItem;
					const slider = sliderBlock?.slider && typeof sliderBlock.slider === 'object'
						? sliderBlock.slider
						: null;
					const slides = normalizeSlides(slider, lang);
					const variant = slider?.titolo?.toLowerCase().includes('gallery') ? 'gallery' : 'hero';
					blockContent = <SliderBlock slides={slides} variant={variant} />;
					break;
				}
				case 'cards_block': {
					const cardsBlock = applyTranslation(block.item as CardsBlockItem, lang);
					const cards = normalizeCards(cardsBlock.card, lang);
					blockContent = <CardsBlock titolo={cardsBlock.titolo} card={cards} />;
					break;
				}
				case 'accordion_block': {
					const accordionBlock = applyTranslation(block.item as AccordionBlockItem, lang);
					const items = normalizeAccordionItems(accordionBlock.accordion, lang);
					blockContent = (
						<AccordionBlock
							titolo={accordionBlock.Titolo || accordionBlock.titolo}
							label={accordionBlock.label}
							link={accordionBlock.link}
							accordion={items}
						/>
					);
					break;
				}
				case 'google_reviews_block':
				case 'google_reviews': {
					const googleReviewsBlock = block.item as GoogleReviewsBlockItem;
					blockContent = (
						<GoogleReviewsBlock
							titolo={googleReviewsBlock.titolo}
							sottotitolo={googleReviewsBlock.sottotitolo}
							google_place_id={googleReviewsBlock.google_place_id}
							google_business_query={googleReviewsBlock.google_business_query}
							numero_recensioni={googleReviewsBlock.numero_recensioni}
							cta_label={googleReviewsBlock.cta_label}
							cta_href={googleReviewsBlock.cta_href}
						/>
					);
					break;
				}
				default:
					return null;
			}

			return (
				<section id={getBlockDomId(block, collection, index)} class={`editor_block editor_block_${collection}`}>
					{blockContent}
				</section>
			);
		})}
	</>
) : (
	<>
		<h1>{notFoundTitleResolved}</h1>
		<p>{notFoundMessageResolved}</p>
	</>
)}
