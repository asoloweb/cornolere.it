---
import { DIRECTUS_URL } from '../lib/directus';
import type { SiteLang } from '../lib/i18n';

interface Props {
	title?: string;
	lang?: SiteLang;
}

const { title = 'Richiedi disponibilita', lang = 'it' } = Astro.props;

const L =
	lang === 'en'
		? {
				nome: 'Full name',
				email: 'Email',
				telefono: 'Phone',
				arrivo: 'Arrival',
				partenza: 'Departure',
				ospiti: 'Number of guests',
				messaggio: 'Message',
				placeholder:
					'Tell us the dates, the number of guests and any special requirements.',
				privacy: 'I accept the <a href="/en/privacy-policy">privacy policy</a>',
				submit: 'Send request',
				sending: 'Sending...',
				success: 'Request sent successfully.',
				error: 'Error sending. Please try again later.',
				notConfigured: 'Form not configured. Set PUBLIC_DIRECTUS_WEBHOOK_RICHIESTE.',
			}
		: {
				nome: 'Nome e cognome',
				email: 'Email',
				telefono: 'Telefono',
				arrivo: 'Arrivo',
				partenza: 'Partenza',
				ospiti: 'Numero ospiti',
				messaggio: 'Messaggio',
				placeholder: 'Indicaci le date, il numero di ospiti e qualsiasi esigenza particolare.',
				privacy: 'Accetto la <a href="/privacy-policy">privacy policy</a>',
				submit: 'Invia richiesta',
				sending: 'Invio in corso...',
				success: 'Richiesta inviata con successo.',
				error: 'Errore durante l\'invio. Riprova piu tardi.',
				notConfigured:
					'Form non configurato. Imposta PUBLIC_DIRECTUS_WEBHOOK_RICHIESTE o PUBLIC_DIRECTUS_FLOW_TRIGGER_ID.',
			};

const flowTriggerId = import.meta.env.PUBLIC_DIRECTUS_FLOW_TRIGGER_ID;
const webhookUrl = import.meta.env.PUBLIC_DIRECTUS_WEBHOOK_RICHIESTE
	? import.meta.env.PUBLIC_DIRECTUS_WEBHOOK_RICHIESTE
	: flowTriggerId
	? `${DIRECTUS_URL}/flows/trigger/${flowTriggerId}`
	: '';
---

<section class="contact_form">
	<h2 class="contact_form_title">{title}</h2>

	<form
		class="contact_form_form"
		method="post"
		data-webhook-url={webhookUrl}
		data-status-sending={L.sending}
		data-status-success={L.success}
		data-status-error={L.error}
	>
		<label class="contact_form_field">
			<span>{L.nome}</span>
			<input name="nome_cognome" type="text" autocomplete="name" required />
		</label>

		<label class="contact_form_field">
			<span>{L.email}</span>
			<input name="email" type="email" autocomplete="email" required />
		</label>

		<label class="contact_form_field">
			<span>{L.telefono}</span>
			<input name="telefono" type="tel" autocomplete="tel" />
		</label>

		<div class="contact_form_grid">
			<label class="contact_form_field">
				<span>{L.arrivo}</span>
				<input name="arrivo" type="date" />
			</label>

			<label class="contact_form_field">
				<span>{L.partenza}</span>
				<input name="partenza" type="date" />
			</label>
		</div>

		<label class="contact_form_field">
			<span>{L.ospiti}</span>
			<input name="ospiti" type="number" min="1" inputmode="numeric" />
		</label>

		<label class="contact_form_field">
			<span>{L.messaggio}</span>
			<textarea name="messaggio" rows={5} placeholder={L.placeholder} required></textarea>
		</label>

		<label class="contact_form_privacy">
			<input name="privacy" type="checkbox" required />
			<span set:html={L.privacy} />
		</label>

		<button class="contact_form_submit MainButton" type="submit">{L.submit}</button>
		<p class="contact_form_status" role="status" aria-live="polite"></p>
	</form>
</section>

<script type="module">
	const form = document.querySelector('.contact_form_form');
	if (form instanceof HTMLFormElement) {
		const statusEl = form.querySelector('.contact_form_status');
		const submitButton = form.querySelector('.contact_form_submit');
		const webhookUrl = form.dataset.webhookUrl;
		const msgSending = form.dataset.statusSending || 'Invio in corso...';
		const msgSuccess = form.dataset.statusSuccess || 'Richiesta inviata con successo.';
		const msgError = form.dataset.statusError || "Errore durante l'invio. Riprova piu tardi.";

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!webhookUrl) {
				if (statusEl) {
					statusEl.textContent =
						'Form non configurato. Imposta PUBLIC_DIRECTUS_WEBHOOK_RICHIESTE o PUBLIC_DIRECTUS_FLOW_TRIGGER_ID.';
					statusEl.dataset.state = 'error';
				}
				return;
			}

			if (submitButton instanceof HTMLButtonElement) {
				submitButton.disabled = true;
			}
			if (statusEl) {
				statusEl.textContent = msgSending;
				statusEl.dataset.state = 'loading';
			}

			try {
				const formData = new FormData(form);
				const nomeCognome = String(formData.get('nome_cognome') || '').trim();
				const email = String(formData.get('email') || '').trim();
				const telefono = String(formData.get('telefono') || '').trim();
				const arrivo = String(formData.get('arrivo') || '').trim();
				const partenza = String(formData.get('partenza') || '').trim();
				const ospiti = String(formData.get('ospiti') || '').trim();
				const messaggio = String(formData.get('messaggio') || '').trim();

				const contattoLines = [
					`Nome e cognome: ${nomeCognome}`,
					`Email: ${email}`,
					`Telefono: ${telefono || '-'}`,
					`Arrivo: ${arrivo || '-'}`,
					`Partenza: ${partenza || '-'}`,
					`Ospiti: ${ospiti || '-'}`,
					`Messaggio: ${messaggio}`,
				];
				const contatto = contattoLines.join('\n');
				const payload = {
					contatto,
					nome_cognome: nomeCognome,
					email,
					telefono,
					arrivo,
					partenza,
					ospiti,
					messaggio,
				};

				const response = await fetch(webhookUrl, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						...payload,
						data: payload,
						payload,
						body: payload,
					}),
				});

				if (!response.ok) {
					throw new Error(`Webhook error: ${response.status}`);
				}

				form.reset();
				if (statusEl) {
					statusEl.textContent = msgSuccess;
					statusEl.dataset.state = 'success';
				}
			} catch (error) {
				console.error('Errore invio richiesta:', error);
				if (statusEl) {
					statusEl.textContent = msgError;
					statusEl.dataset.state = 'error';
				}
			} finally {
				if (submitButton instanceof HTMLButtonElement) {
					submitButton.disabled = false;
				}
			}
		});
	}
</script>

<style>
	.contact_form {
		background: var(--primary);
		border-radius: 24px;
		padding: 28px;
		color: #fffaf0;
		box-shadow: 0 18px 36px rgba(15, 61, 46, 0.18);
	}

	.contact_form_title {
		margin: 0 0 18px;
		font-size: 28px;
	}

	.contact_form_form {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.contact_form_grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}

	.contact_form_field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 14px;
	}

	.contact_form_field input,
	.contact_form_field textarea {
		border: 1px solid rgba(255, 250, 240, 0.3);
		border-radius: 16px;
		padding: 12px 14px;
		font: inherit;
		background: #fffaf0;
		color: var(--nero);
	}

	.contact_form_field textarea {
		resize: vertical;
		min-height: 120px;
	}

	.contact_form_privacy {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-top: 4px;
		font-size: 14px;
	}

	.contact_form_privacy input {
		width: 18px;
		height: 18px;
	}

	.contact_form_privacy a {
		color: var(--primary);
		text-decoration: underline;
	}

	.contact_form_submit.MainButton {
		margin-top: 6px;
		border: 0;
		border-radius: 999px;
		min-width: 0 !important;
		width: 100%;
		padding: 16px 18px !important;
		background: #fffaf0 !important;
		color: var(--primary) !important;
		font-family: var(--font-heading);
		font-size: 24px;
		text-align: center;
		cursor: pointer;
		transition: transform 180ms ease, opacity 180ms ease;
	}

	.contact_form_submit:hover {
		transform: translateY(-2px);
		opacity: 0.95;
	}

	.contact_form_submit:disabled {
		opacity: 0.7;
		cursor: not-allowed;
		transform: none;
	}

	.contact_form_status {
		margin: 6px 2px 0;
		font-size: 14px;
		min-height: 20px;
	}

	.contact_form_status[data-state='success'] {
		color: #1c7c3a;
	}

	.contact_form_status[data-state='error'] {
		color: #ffb4a8;
	}

	.contact_form_status[data-state='loading'] {
		color: #d0d5dd;
	}

	@media (max-width: 620px) {
		.contact_form_grid {
			grid-template-columns: 1fr;
		}
	}
</style>
