---
import { Image } from 'astro:assets';
import { DIRECTUS_URL } from '../lib/directus';

interface PageRef {
	id?: number;
	slug?: string;
}

interface SingleCard {
	id?: number;
	titolo_card?: string;
	descrizione?: string;
	immagine?: string;
	href?: string;
	link?: PageRef | number | null;
}

interface CardRelation {
	single_card_id?: SingleCard | number | null;
}

interface Props {
	titolo?: string;
	card?: CardRelation[] | SingleCard[];
}

const { titolo = '', card = [] } = Astro.props;

function resolveImageSrc(value: string | undefined) {
	if (!value) return '';
	if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('/')) {
		return value;
	}
	return `${DIRECTUS_URL}/assets/${value}`;
}

function normalizeCards(input: CardRelation[] | SingleCard[]) {
	if (!Array.isArray(input)) return [];
	return input
		.map((entry) => {
			if (!entry || typeof entry !== 'object') return null;
			if ('single_card_id' in entry) {
				return entry.single_card_id && typeof entry.single_card_id === 'object'
					? (entry.single_card_id as SingleCard)
					: null;
			}
			if ('titolo_card' in entry || 'descrizione' in entry || 'immagine' in entry || 'href' in entry) {
				return entry as SingleCard;
			}
			return null;
		})
		.filter((entry): entry is SingleCard => Boolean(entry));
}

function getCardHref(card: SingleCard) {
	if (card.href) return card.href;
	if (card.link && typeof card.link === 'object' && card.link.slug) {
		return card.link.slug === 'home' ? '/' : `/${card.link.slug}`;
	}
	return '';
}

function stripHtml(value: string) {
	return value.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
}

function normalizeText(value: string) {
	return stripHtml(value)
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase();
}

function getCardIconClass(cardTitle: string | undefined) {
	const title = normalizeText(cardTitle || '');
	if (title.includes('camer') || title.includes('room')) return 'fa-solid fa-bed';
	if (title.includes('colazione') || title.includes('breakfast')) return 'fa-solid fa-mug-saucer';
	if (title.includes('natura') || title.includes('nature')) return 'fa-solid fa-tree';
	if (title.includes('posizione') || title.includes('location')) return 'fa-solid fa-map-location-dot';
	if (title.includes('parcheggio') || title.includes('parking')) return 'fa-solid fa-square-parking';
	if (title.includes('wi-fi') || title.includes('wifi')) return 'fa-solid fa-wifi';
	return 'fa-solid fa-leaf';
}

const cards = normalizeCards(card);
const normalizedTitle = normalizeText(titolo);
const usesServiceIcons =
	normalizedTitle.includes('perche scegliere') || normalizedTitle.includes('why choose');
const isRoomsBlock = normalizedTitle.includes('camere') || normalizedTitle.includes('rooms');
---

{cards.length > 0 && (
	<section class:list={['cards_block', { cards_block_rooms: isRoomsBlock }]} data-aos="fade-up" data-aos-duration="1500">
		<div class="cards_block_inner">
			{titolo && <h2 class="cards_block_title" set:html={titolo} />}

			<div class="cards_grid">
				{cards.map((single) => {
					const href = getCardHref(single);
					const Tag = href ? 'a' : 'div';
					const imageSrc = resolveImageSrc(single.immagine);
					const iconClass = usesServiceIcons ? getCardIconClass(single.titolo_card) : '';

					return (
						<Tag class="cards_card" href={href || undefined} aria-label={href ? `Scopri ${stripHtml(single.titolo_card || 'la camera')}` : undefined}>
							{iconClass ? (
								<div class="cards_card_icon" aria-hidden="true">
									<i class={iconClass}></i>
								</div>
							) : imageSrc && (
								<div class="cards_card_media">
									<Image
										src={imageSrc}
										alt={single.titolo_card || ''}
										width={720}
										height={540}
										widths={[320, 480, 720]}
										sizes="(max-width: 767px) calc(100vw - 68px), (max-width: 1100px) calc(50vw - 51px), 380px"
										format="webp"
										loading="lazy"
									/>
								</div>
							)}
							{single.titolo_card && <h3 class="cards_card_title" set:html={single.titolo_card} />}
							{single.descrizione && <p class="cards_card_description" set:html={single.descrizione} />}
						</Tag>
					);
				})}
			</div>
		</div>
	</section>
)}

<style>
	.cards_block {
		margin-bottom:40px;
	}

	.cards_block_inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding:34px;
		border-radius:34px;
		background-color: var(--surface);
		border: 1px solid var(--border-soft);
		box-shadow: 0 18px 44px rgba(15, 61, 46, 0.07);
	}

	.cards_block_title {
		margin: 20px 0 34px;
		font-size: clamp(42px, 5vw, 66px);
		line-height: 0.98;
		letter-spacing: -0.03em;
	}

	.cards_block_title :global(span) {
		color: var(--primary);
	}

	.cards_block_inner :global(span) {
		color: var(--primary);
	}

	.cards_grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		margin-bottom:40px;
	}

	.cards_block_rooms .cards_grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.cards_block_rooms .cards_card {
		padding: 0 0 22px;
		justify-content: flex-start;
		overflow: hidden;
	}

	.cards_block_rooms .cards_card_media {
		width: 100%;
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

	.cards_block_rooms .cards_card_media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 300ms ease;
	}

	.cards_block_rooms a.cards_card:hover .cards_card_media img {
		transform: scale(1.04);
	}

	.cards_block_rooms .cards_card_title,
	.cards_block_rooms .cards_card_description {
		padding-inline: 18px;
	}

	.cards_block_rooms .cards_card_title {
		font-size: 24px;
	}

	.cards_block_rooms a.cards_card:focus-visible {
		outline: 3px solid var(--secondary);
		outline-offset: 4px;
	}

	.cards_card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 22px;
		background: var(--bianco);
		border-radius: 24px;
		color: var(--nero);
		transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
		min-height: 100%;
		border: 1px solid var(--border-soft);
		box-shadow: 0 12px 26px rgba(15, 61, 46, 0.08);
		text-align: center;
		align-items: center;
		min-height: 240px;
		justify-content: center;
	}

	a.cards_card:hover {
		transform: translateY(-4px);
		border-color: rgba(15, 61, 46, 0.28);
		box-shadow: 0 18px 34px rgba(15, 61, 46, 0.14);
	}

	.cards_card_title {
		margin: 4px 0 0;
		font-size: 28px;
		line-height: 1.05;
	}

	.cards_card_icon {
		width: 76px;
		height: 76px;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: rgba(15, 61, 46, 0.1);
		color: var(--primary);
		font-size: 34px;
		margin-bottom: 8px;
	}

	.cards_card_description {
		margin: 4px 0 0;
		font-size: 16px;
		line-height: 1.55;
		color: #536157;
	}

	@media (max-width: 1024px) {
		.cards_grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.cards_grid,
		.cards_block_rooms .cards_grid {
			grid-template-columns: 1fr;
		}
	}
</style>
