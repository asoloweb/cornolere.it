---
import { Image } from 'astro:assets';
import { DIRECTUS_URL } from '../lib/directus';

interface Props {
	item: string;
	titolo?: string;
	sottotitolo?: string;
	paragrafo?: string;
	href?: string;
	label?: string;
	immagine?: string;
	inverti?: boolean;
	background_color?: string;
}

const { 
	item, 
	titolo = '', 
	sottotitolo = '', 
	paragrafo = '', 
	href = '', 
	label = '', 
	immagine = '',
	inverti = false,
	background_color = ''
} = Astro.props;

function resolveImageSrc(value: string) {
	if (!value) return '';
	if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('/')) {
		return value;
	}
	return `${DIRECTUS_URL}/assets/${value}`;
}
---

<div
	data-aos="fade-up"
     data-aos-duration="1500"
	class={`hero_block${inverti ? ' hero_block_inverted' : ''}`}
	style={background_color ? `background-color: ${background_color};` : undefined}
>
	{immagine && (
		<div class="colonna colonna_immagine">
			<Image
				class="hero_image"
				data-aos="fade-up"
				data-aos-duration="2000"
				src={resolveImageSrc(immagine)}
				alt={sottotitolo || titolo}
				width={1200}
				height={800}
			/>
		</div>
	)}
	<div class="colonna colonna_testo">
		{titolo && <div class="title" set:html={titolo} />}
		{sottotitolo && <h3 set:html={sottotitolo} />}
		{paragrafo && <div class="hero_text" set:html={paragrafo} />}
		{label && href && (
			<a class="hero_button MainButton" href={href}>
				{label}
			</a>
		)}
	</div>
</div>

<style>
	.hero_block {
		padding: 34px;
		margin-bottom: 50px;
		display: flex;
		gap: 50px;
		border-radius: 34px;
		max-width: var(--max-width);
		margin: auto;
		margin-bottom:40px;
		background-color: var(--surface);
		border: 1px solid var(--border-soft);
		box-shadow: 0 18px 44px rgba(15, 61, 46, 0.08);
	}
	.colonna {
		flex: 1;
	}

	.hero_block_inverted {
		flex-direction: row-reverse;
	}

	.colonna_testo {
		display: flex;
		flex-direction: column;
		justify-content: center;	
	}

	.colonna_testo h3 {
		font-size: 20px;
		line-height: 1.55;
		margin: 0;
		margin-bottom: 25px;
		font-family: var(--font-body);
		font-weight: 400;
		color: #536157;
	}

	.colonna_testo .title {
		font-size: clamp(44px, 5vw, 72px);
		font-family: var(--font-heading);
		line-height: 0.95;
		margin-top: 40px;
		margin-bottom: 20px;
		font-weight: 700;
		letter-spacing: -0.03em;
	}

	.colonna_immagine img {
		object-fit: cover;
		height: 100%;
	    	border-radius: 26px;
		box-shadow: 0 14px 34px rgba(15, 61, 46, 0.16);
	}

	.hero_button {
		display: inline-block;
		color: var(--secondary);
		text-decoration: none;
	}
	.hero_text {
		margin: 0 0 30px;
		line-height: 1.7;
		font-size: 18px;
		font-weight: 400;
		color: #445047;
	}
	.hero_image {
		max-width: 100%;
		height: auto;
		display: block;
	}
</style>
