---
import { DIRECTUS_URL } from '../lib/directus';

interface SlideItem {
	titolo?: string;
	sottotitolo?: string;
	label?: string;
	href?: string;
	immagine?: string;
}

interface Props {
	slides?: SlideItem[];
	titolo?: string;
	sottotitolo?: string;
	label?: string;
	href?: string;
}

const {
	slides = [],
	titolo = '',
	sottotitolo = '',
	label = '',
	href = '',
} = Astro.props;

const resolvedSlides =
	slides.length > 0
		? slides
		: [
				{
					titolo,
					sottotitolo,
					label,
					href,
				},
		  ];

const hasMultipleSlides = resolvedSlides.length > 1;

const sliderId = `slider-${Math.random().toString(36).slice(2)}`;

function resolveImageSrc(value: string | undefined) {
	if (!value) return '';
	if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('/')) {
		return value;
	}
	return `${DIRECTUS_URL}/assets/${value}`;
}
---

<div
	class="slider_block swiper"
	id={sliderId}
	data-swiper-enabled={hasMultipleSlides ? 'true' : 'false'}
>
	<div class="swiper-wrapper">
		{resolvedSlides.map((slide) => (
			<div
				class="swiper-slide single_slide"
				style={slide.immagine ? `background-image: url('${resolveImageSrc(slide.immagine)}')` : ''}
			>
				{slide.titolo && <h1 data-aos="fade-up" data-aos-duration="1500" set:html={slide.titolo} />}
				{slide.sottotitolo && <h2 data-aos="fade-up" data-aos-duration="1800" set:html={slide.sottotitolo} />}
				{slide.label && slide.href && (
					<button data-aos="fade-up" data-aos-duration="2000" class="slider_button MainButton" type="button" data-href={slide.href}>
						{slide.label}
					</button>
				)}
				{slide.immagine && (
					<span class="slide_image_sr" aria-hidden="true"></span>
				)}
			</div>
		))}
	</div>
	{hasMultipleSlides && <div class="swiper-pagination"></div>}
	{hasMultipleSlides && <div class="swiper-button-prev"></div>}
	{hasMultipleSlides && <div class="swiper-button-next"></div>}
</div>


<style>
		.title_block {
			margin: 32px 0 16px;
			border-left: 6px solid var(--secondary);
			padding-left: 14px;
		}

		.title_block h1 {
		margin: 0;
		color: var(--primary);
		}

		.slider_block {
			display: grid;
			gap: 16px;
			height: min(720px, calc(100vh - 220px));
			max-width: 1440px;
			margin: auto;
			margin-bottom:40px;
			width: calc(100% - 40px);
			border-radius: 34px;
			overflow: hidden;
			box-shadow: 0 22px 50px rgba(15, 61, 46, 0.2);
		}

		.slider_block .single_slide {
		min-height: 220px;
		padding: clamp(34px, 6vw, 82px);
		border-radius: 34px;
		background-size: cover;
		background-position: center;
		color: #fffaf0;
		position: relative;
		overflow: hidden;
		}

		.slider_button {
		background-color: transparent;
		color: var(--secondary);
		border: navajowhite;
		font-size: 18px;
		font-weight: 600;
		font-family: var(--font-heading);
		}

		.single_slide h1 {
			font-size: clamp(54px, 8vw, 112px);
			line-height: 0.9;
			margin:0;
			max-width: 760px;
			color: #fff;
			text-shadow: 0 4px 10px rgba(0, 0, 0, 0.72), 0 14px 34px rgba(0, 0, 0, 0.48);
			letter-spacing: -0.04em;
		}

		.single_slide h2 {
			max-width: 620px;
			color: #fff;
			text-shadow: 0 3px 8px rgba(0, 0, 0, 0.74), 0 10px 26px rgba(0, 0, 0, 0.48);
			font-family: var(--font-body);
			font-size: clamp(18px, 2.4vw, 28px);
			line-height: 1.45;
			font-weight: 400;
		}

		.slider_block .single_slide > * {
		position: relative;
		z-index: 1;
		}

	.single_slide {
		padding: 60px;
		background-size: cover !important;
		background-position: center;
		min-height: 240px;
		display: flex;
		flex-direction: column;
		align-items: start;
		justify-content: center;
		gap: 8px;
	}
	.slide_image_sr {
		display: none;
	}
	:global(.swiper-button-prev),
	:global(.swiper-button-next) {
		color: #111;
	}

	@media (max-width: 640px) {
		.single_slide h1 {
			font-size:45px;
			line-height:50px;
		}
	}
</style>
