---
import { directusAssetUrl } from '../lib/directus';

interface SlideItem {
	titolo?: string;
	sottotitolo?: string;
	label?: string;
	href?: string;
	immagine?: string;
}

interface Props {
	slides?: SlideItem[];
	titolo?: string;
	sottotitolo?: string;
	label?: string;
	href?: string;
	variant?: 'hero' | 'gallery';
}

const {
	slides = [],
	titolo = '',
	sottotitolo = '',
	label = '',
	href = '',
	variant = 'hero',
} = Astro.props;

const resolvedSlides =
	slides.length > 0
		? slides
		: [
				{
					titolo,
					sottotitolo,
					label,
					href,
				},
		  ];

const hasMultipleSlides = resolvedSlides.length > 1;

const sliderId = `slider-${Math.random().toString(36).slice(2)}`;

function resolveImageSrc(value: string | undefined) {
	return directusAssetUrl(value, {
		width: 1800,
		height: variant === 'gallery' ? 1200 : 1000,
		quality: 85,
		format: 'webp',
		fit: 'cover',
	});
}
---

<div
	class:list={['slider_block', 'swiper', { room_gallery: variant === 'gallery' }]}
	id={sliderId}
	data-swiper-enabled={hasMultipleSlides ? 'true' : 'false'}
>
	<div class="swiper-wrapper">
		{resolvedSlides.map((slide, index) => (
			<div
				class="swiper-slide single_slide"
				style={variant === 'hero' && slide.immagine ? `background-image: url('${resolveImageSrc(slide.immagine)}')` : ''}
			>
				{variant === 'gallery' ? (
					<figure class="gallery_figure">
						{slide.immagine && <img src={resolveImageSrc(slide.immagine)} alt={slide.titolo || `Foto ${index + 1} della camera`} loading={index === 0 ? 'eager' : 'lazy'} />}
						{slide.sottotitolo && <figcaption set:html={slide.sottotitolo} />}
					</figure>
				) : (
					<>
						{slide.titolo && <h1 data-aos="fade-up" data-aos-duration="1500" set:html={slide.titolo} />}
						{slide.sottotitolo && <h2 data-aos="fade-up" data-aos-duration="1800" set:html={slide.sottotitolo} />}
						{slide.label && slide.href && (
							<button data-aos="fade-up" data-aos-duration="2000" class="slider_button MainButton" type="button" data-href={slide.href}>
								{slide.label}
							</button>
						)}
					</>
				)}
			</div>
		))}
	</div>
	{hasMultipleSlides && <div class="swiper-pagination"></div>}
	{hasMultipleSlides && <div class="swiper-button-prev"></div>}
	{hasMultipleSlides && <div class="swiper-button-next"></div>}
</div>


<style>
		.title_block {
			margin: 32px 0 16px;
			border-left: 6px solid var(--secondary);
			padding-left: 14px;
		}

		.title_block h1 {
		margin: 0;
		color: var(--primary);
		}

		.slider_block {
			display: grid;
			gap: 16px;
			height: min(720px, calc(100vh - 220px));
			max-width: 1440px;
			margin: auto;
			margin-bottom:40px;
			width: calc(100% - 40px);
			border-radius: 34px;
			overflow: hidden;
			box-shadow: 0 22px 50px rgba(15, 61, 46, 0.2);
		}

		.slider_block .single_slide {
		min-height: 220px;
		padding: clamp(34px, 6vw, 82px);
		border-radius: 34px;
		background-size: cover;
		background-position: center;
		color: #fffaf0;
		position: relative;
		overflow: hidden;
		}

		.slider_button {
		background-color: transparent;
		color: var(--secondary);
		border: navajowhite;
		font-size: 18px;
		font-weight: 600;
		font-family: var(--font-heading);
		}

		.single_slide h1 {
			font-size: clamp(54px, 8vw, 112px);
			line-height: 0.9;
			margin:0;
			max-width: 760px;
			color: #fff;
			text-shadow: 0 4px 10px rgba(0, 0, 0, 0.72), 0 14px 34px rgba(0, 0, 0, 0.48);
			letter-spacing: -0.04em;
		}

		.single_slide h2 {
			max-width: 620px;
			color: #fff;
			text-shadow: 0 3px 8px rgba(0, 0, 0, 0.74), 0 10px 26px rgba(0, 0, 0, 0.48);
			font-family: var(--font-body);
			font-size: clamp(18px, 2.4vw, 28px);
			line-height: 1.45;
			font-weight: 400;
		}

		.slider_block .single_slide > * {
		position: relative;
		z-index: 1;
		}

	.single_slide {
		padding: 60px;
		background-size: cover !important;
		background-position: center;
		min-height: 240px;
		display: flex;
		flex-direction: column;
		align-items: start;
		justify-content: center;
		gap: 8px;
	}
		.room_gallery {
			height: auto;
			aspect-ratio: 3 / 2;
			background: var(--surface-muted);
		}

		.room_gallery .single_slide {
			min-height: 0;
			padding: 0;
			background: transparent;
		}

		.gallery_figure {
			width: 100%;
			height: 100%;
			margin: 0;
			position: relative;
		}

		.gallery_figure img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.gallery_figure figcaption {
			position: absolute;
			left: 24px;
			bottom: 24px;
			max-width: calc(100% - 48px);
			padding: 10px 16px;
			border-radius: 999px;
			background: rgba(15, 61, 46, 0.84);
			color: #fff;
			font-size: 15px;
		}

		.room_gallery :global(.swiper-button-prev),
		.room_gallery :global(.swiper-button-next) {
			color: #fff;
			text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
		}

		:global(.swiper-button-prev),
	:global(.swiper-button-next) {
		color: #111;
	}

	@media (max-width: 640px) {
		.single_slide h1 {
			font-size:45px;
			line-height:50px;
		}

		.room_gallery {
			width: calc(100% - 24px);
			aspect-ratio: 4 / 3;
			border-radius: 24px;
		}

		.gallery_figure figcaption {
			left: 12px;
			bottom: 12px;
			max-width: calc(100% - 24px);
		}
	}
</style>
