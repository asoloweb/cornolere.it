---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DIRECTUS_URL, directusItemsUrl } from '../lib/directus';
import { ui, type SiteLang } from '../lib/i18n';
import '../styles/global.css';

export interface Props {
	title: string;
	seoTitle?: string;
	seoDescription?: string;
	lang?: SiteLang;
	langSwitchHref?: string;
	additionalJsonLd?: string;
}

const { title, seoTitle, seoDescription, lang = 'it', langSwitchHref, additionalJsonLd } = Astro.props;
const resolvedTitle = seoTitle || title;
const htmlLang = lang === 'en' ? 'en' : 'it';
const ogLocale = lang === 'en' ? 'en_US' : 'it_IT';
const uiStrings = ui(lang);
const defaultSwitchHref = lang === 'en' ? '/' : '/en/';
const switchHref = langSwitchHref || defaultSwitchHref;
const shouldLoadThirdPartyScripts = !import.meta.env.DEV;
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || 'https://cornolere.it').replace(/\/+$/, '');
const socialImageUrl = `${DIRECTUS_URL}/assets/87f6a9c8-ce5b-4ee2-b040-a687bd85eb01.png`;
const canonicalUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const alternateLangUrl = new URL(switchHref, `${siteUrl}/`).toString();
const itLangUrl = lang === 'it' ? canonicalUrl : alternateLangUrl;
const enLangUrl = lang === 'en' ? canonicalUrl : alternateLangUrl;
const organizationName =
	import.meta.env.PUBLIC_ORGANIZATION_NAME || "Ca'Cornolere";
const organizationEmail =
	import.meta.env.PUBLIC_ORGANIZATION_EMAIL || 'info@cornolere.it';
const organizationStreetAddress =
	import.meta.env.PUBLIC_ORGANIZATION_STREET || 'Via Collalto, 42';
const organizationLocality =
	import.meta.env.PUBLIC_ORGANIZATION_CITY || '31030 Castelcucco TV';
const organizationCountry =
	import.meta.env.PUBLIC_ORGANIZATION_COUNTRY || 'IT';
const organizationTelephone =
	import.meta.env.PUBLIC_ORGANIZATION_TELEPHONE || '+393398038658';
const organizationAreaServed =
	import.meta.env.PUBLIC_ORGANIZATION_AREA_SERVED || 'IT';
const organizationSameAs = (import.meta.env.PUBLIC_ORGANIZATION_SAME_AS || '')
	.split(',')
	.map((entry) => entry.trim())
	.filter(Boolean);
const umamiScriptSrc = import.meta.env.PUBLIC_UMAMI_SCRIPT_SRC || 'https://umami.asoloweb.it/script.js';
const umamiWebsiteId =
	import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || 'e5ebd6d3-935e-491b-86a8-8fafb35ce75b';

function resolveImageSrc(value: string) {
	if (!value) return '';
	if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('/')) {
		return value;
	}
	return `${DIRECTUS_URL}/assets/${value}`;
}

let logoLightSrc = import.meta.env.PUBLIC_LOGO_LIGHT || '/favicon.png';

try {
	const optionsUrl = directusItemsUrl('options');
	optionsUrl.searchParams.set('fields', 'logo_light');
	const optionsResponse = await fetch(optionsUrl);
	if (optionsResponse.ok) {
		const optionsPayload = await optionsResponse.json();
		const options =
			optionsPayload?.data && Array.isArray(optionsPayload.data)
				? optionsPayload.data[0]
				: optionsPayload?.data;
		if (options?.logo_light) {
			logoLightSrc = resolveImageSrc(options.logo_light);
		}
	}
} catch (error) {
	console.error('Error fetching options for favicon:', error);
}

const absoluteLogoUrl = (() => {
	try {
		return new URL(logoLightSrc, siteUrl).toString();
	} catch {
		return logoLightSrc;
	}
})();

function getFaviconMimeType(src: string) {
	const cleanedSrc = src.split('?')[0].split('#')[0].toLowerCase();
	if (cleanedSrc.endsWith('.svg')) return 'image/svg+xml';
	if (cleanedSrc.endsWith('.png')) return 'image/png';
	if (cleanedSrc.endsWith('.webp')) return 'image/webp';
	if (cleanedSrc.endsWith('.jpg') || cleanedSrc.endsWith('.jpeg')) return 'image/jpeg';
	if (cleanedSrc.endsWith('.ico')) return 'image/x-icon';
	return undefined;
}

const faviconSrc = '/favicon.png';
const faviconMimeType = getFaviconMimeType(faviconSrc);

const organizationId = `${siteUrl}/#organization`;
const lodgingBusinessId = `${siteUrl}/#struttura`;
const organizationJsonLd = JSON.stringify(
	{
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'Organization',
				'@id': organizationId,
				name: organizationName,
				url: siteUrl,
				logo: absoluteLogoUrl,
				email: organizationEmail,
				sameAs: organizationSameAs,
			},
			{
				'@type': 'BedAndBreakfast',
				'@id': lodgingBusinessId,
				name: organizationName,
				url: siteUrl,
				telephone: organizationTelephone,
				priceRange: '€€',
				image: [socialImageUrl, absoluteLogoUrl],
				email: organizationEmail,
				address: {
					'@type': 'PostalAddress',
					streetAddress: organizationStreetAddress,
					addressLocality: organizationLocality,
					addressCountry: organizationCountry,
				},
				geo: {
					'@type': 'GeoCoordinates',
					latitude: 45.8360365,
					longitude: 11.9027936,
				},
				checkinTime: '15:00',
				checkoutTime: '10:00',
				amenityFeature: [
					{
						'@type': 'LocationFeatureSpecification',
						name: 'Wi-Fi gratuito',
						value: true,
					},
					{
						'@type': 'LocationFeatureSpecification',
						name: 'Parcheggio',
						value: true,
					},
				],
				areaServed: organizationAreaServed,
				provider: {
					'@id': organizationId,
				},
			},
		],
	},
	null,
	2
);
---

<html lang={htmlLang}>
	<head>
		<script type="text/javascript" src="https://embeds.iubenda.com/widgets/6726a87f-9201-47ba-acdd-30de462d274f.js"></script>
		<meta charset="utf-8" />
		<link rel="icon" type={faviconMimeType} href={faviconSrc} />
		<link rel="shortcut icon" type={faviconMimeType} href={faviconSrc} />
		<link rel="apple-touch-icon" href={faviconSrc} />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#0f3d2e" />
		<meta name="generator" content={Astro.generator} />
		<title>{resolvedTitle}</title>
		{seoDescription && <meta name="description" content={seoDescription} />}
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="it" href={itLangUrl} />
		<link rel="alternate" hreflang="en" href={enLangUrl} />
		<link rel="alternate" hreflang="x-default" href={itLangUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:title" content={resolvedTitle} />
		{seoDescription && <meta property="og:description" content={seoDescription} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={organizationName} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1536" />
		<meta property="og:image:height" content="1024" />
		<meta property="og:image:alt" content={organizationName} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={resolvedTitle} />
		{seoDescription && <meta name="twitter:description" content={seoDescription} />}
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content={organizationName} />
		<script type="application/ld+json" set:html={organizationJsonLd}></script>
		{additionalJsonLd && <script type="application/ld+json" set:html={additionalJsonLd}></script>}
		<link rel="stylesheet" href="/vendor/aos.css" />
		<link rel="stylesheet" href="/vendor/swiper-bundle.min.css" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
		{shouldLoadThirdPartyScripts && (
			<>
				<script defer src={umamiScriptSrc} data-website-id={umamiWebsiteId}></script>
			</>
		)}
		<!-- Google tag (gtag.js) --> <script async src="https://www.googletagmanager.com/gtag/js?id=AW-10932709528"></script> <script> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'AW-10932709528'); </script>

		<script type="text/javascript">
			(function(c,l,a,r,i,t,y){
				c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
				t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
				y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
			})(window, document, "clarity", "script", "vqwzxpkr6z");
		</script>
	</head>
	<body>
		<Header lang={lang} langSwitchHref={switchHref} />
		<main>
			<slot />
		</main>
		<Footer lang={lang} />
		<script defer src="/vendor/aos.js"></script>
		<script defer src="/scripts/aos-init.js"></script>
		<script defer src="/scripts/swiper-init.js"></script>
		<slot name="scripts" />
	</body>
</html>
