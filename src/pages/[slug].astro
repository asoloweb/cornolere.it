---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContent from '../components/PageContent.astro';
import { directusFetch, directusItemsUrl } from '../lib/directus';
import { PAGE_SLUG_TRANSLATION_FIELDS, findTranslationSlug } from '../lib/directusPages';

type Page = {
	status?: string;
	slug?: string;
	title?: string;
	Titolo?: string;
	seo_title?: string;
	seo_desc?: string;
	hide_page_header?: boolean;
	page_header?: string;
	editor?: unknown[];
	translations?: unknown[];
};

async function fetchPageBySlug(slug: string) {
	const url = directusItemsUrl('pages');
	url.searchParams.set(
		'fields',
		`*,${PAGE_SLUG_TRANSLATION_FIELDS},editor.item.*,editor.item.slider.*,editor.item.slider.slides.item.*,editor.item.card.single_card_id.*,editor.item.card.single_card_id.link.id,editor.item.card.single_card_id.link.slug,editor.item.card.single_card_id.link.title,editor.item.accordion.single_accordion_id.*`
	);
	url.searchParams.set('filter[status][_eq]', 'published');
	url.searchParams.set('filter[_or][0][slug][_eq]', slug);
	url.searchParams.set('filter[_or][1][slug][slug][_eq]', slug);
	const response = await directusFetch(url);
	const data = await response.json();
	return (data?.data?.[0] as Page | undefined) ?? null;
}

const routeSlug = String(Astro.params.slug || '').trim();
const page =
	(Astro.props?.page as Page | undefined) ||
	(routeSlug ? await fetchPageBySlug(routeSlug) : null);
const enSlug = findTranslationSlug(page?.translations, 'en');
const langSwitchHref = enSlug ? (enSlug === 'home' ? '/en/' : `/en/${enSlug}`) : '/en/';
const additionalJsonLd = Astro.props?.additionalJsonLd as string | undefined;
---

<BaseLayout
	title={page?.title || page?.Titolo || 'Pagina'}
	seoTitle={page?.seo_title}
	seoDescription={page?.seo_desc}
	lang="it"
	langSwitchHref={langSwitchHref}
	additionalJsonLd={additionalJsonLd}
>
	<PageContent page={page} lang="it" />
</BaseLayout>
