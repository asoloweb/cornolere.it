---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContent from '../../components/PageContent.astro';
import { directusFetch, directusItemsUrl } from '../../lib/directus';
import { EN_PAGE_FIELDS } from '../../lib/directusPages';
import { applyTranslation } from '../../lib/i18n';

type Page = {
	status?: string;
	slug?: string;
	title?: string;
	seo_title?: string;
	seo_desc?: string;
	hide_page_header?: boolean;
	editor?: unknown[];
};

async function fetchHomeEn() {
	const url = directusItemsUrl('pages');
	url.searchParams.set('fields', EN_PAGE_FIELDS);
	url.searchParams.set('filter[status][_eq]', 'published');
	url.searchParams.set('filter[slug][_eq]', 'home');
	const response = await directusFetch(url);
	const data = await response.json();
	return (data?.data?.[0] as Page | undefined) ?? null;
}

const rawPage = await fetchHomeEn();
const page = rawPage ? applyTranslation(rawPage, 'en') : null;
---

<BaseLayout
	title={page?.title || 'Home'}
	seoTitle={page?.seo_title}
	seoDescription={page?.seo_desc}
	lang="en"
	langSwitchHref="/"
>
	<PageContent page={page} lang="en" />
	<section class="trustindex_reviews_block">
		<div class="trustindex_reviews_inner">
			<h2 class="trustindex_reviews_title">What they say about us</h2>
			<script
				defer
				async
				src='https://cdn.trustindex.io/loader.js?787bc5882d9d64819626a821c67'
			></script>
		</div>
	</section>
</BaseLayout>
