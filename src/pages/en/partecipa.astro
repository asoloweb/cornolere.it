---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageContent from '../../components/PageContent.astro';
import PartecipaForm from '../../components/PartecipaForm.astro';
import GoogleReviewsBlock from '../../components/google_reviews_block.astro';
import HeroBlock from '../../components/hero_block.astro';
import { DIRECTUS_URL, directusFetch, directusItemsUrl } from '../../lib/directus';
import { EN_PAGE_FIELDS } from '../../lib/directusPages';
import { applyTranslation } from '../../lib/i18n';

type Page = {
	status?: string;
	slug?: string;
	title?: string;
	seo_title?: string;
	seo_desc?: string;
	description?: string;
	hide_page_header?: boolean;
	featured_image?: string;
	editor?: unknown[];
};

type HeroBlockItem = {
	id?: number;
	titolo?: string;
	sottotitolo?: string;
	paragrafo?: string;
	label?: string;
	href?: string;
	immagine?: string;
	inverti?: boolean;
	background_color?: string;
};

async function fetchPartecipaPage() {
	const url = directusItemsUrl('pages');
	url.searchParams.set('fields', EN_PAGE_FIELDS);
	url.searchParams.set('filter[status][_eq]', 'published');
	url.searchParams.set('filter[slug][_eq]', 'partecipa');
	const response = await directusFetch(url);
	const data = await response.json();
	return (data?.data?.[0] as Page | undefined) ?? null;
}

const rawPage: Page | null = await fetchPartecipaPage();
const page = rawPage ? applyTranslation(rawPage, 'en') : null;
const pageTitle = page?.title || '';
const pageDescription = page?.description || '';

const homeHeroEn: HeroBlockItem = {
	id: 14,
	titolo: 'Book your <span>stay at B&B Cornolere</span>',
	sottotitolo:
		'Tell us your preferred dates and your preferences: we will reply as soon as possible with availability, included services and useful information for planning your stay.',
	paragrafo: '<p>Welcoming rooms, a kitchen available to guests and tranquillity immersed in nature.</p>',
	label: 'Discover the property >',
	href: '/en/the-structure',
	immagine: '8b687459-9b7e-489a-bbcd-f1bc80f43718',
	inverti: false,
	background_color: '',
};

function resolveImageSrc(value: string) {
	if (!value) return '';
	if (value.startsWith('http://') || value.startsWith('https://') || value.startsWith('/')) {
		return value;
	}
	return `${DIRECTUS_URL}/assets/${value}`;
}

const pageHeaderImage = page?.featured_image ? resolveImageSrc(page.featured_image) : '';
const showPageHeader = page ? !page.hide_page_header : false;
---

<BaseLayout
	title={pageTitle || 'Book Your Stay'}
	seoTitle={page?.seo_title}
	seoDescription={page?.seo_desc}
	lang="en"
	langSwitchHref="/partecipa"
>
	{page && (
		<div class="partecipa_preheader">
			<div class="partecipa_preheader_inner">
				<section id="block-hero-block-14-2" class="editor_block editor_block_hero_block">
					<HeroBlock
						item={String(homeHeroEn.id ?? '14')}
						titolo={homeHeroEn.titolo}
						sottotitolo={homeHeroEn.sottotitolo}
						paragrafo={homeHeroEn.paragrafo}
						label={homeHeroEn.label}
						href={homeHeroEn.href}
						immagine={homeHeroEn.immagine}
						inverti={homeHeroEn.inverti}
						background_color={homeHeroEn.background_color}
					/>
				</section>
				<div class="partecipa_preheader_form">
					<PartecipaForm title="Request availability for your stay" lang="en" />
				</div>
			</div>
		</div>
	)}
	<GoogleReviewsBlock
		titolo="What our guests say"
		sottotitolo="Google reviews of Ca'Cornolere"
		google_business_query="Ca'Cornolere"
		numero_recensioni={6}
	/>

	{showPageHeader && (
		<div
			class="page_header"
			style={pageHeaderImage ? `background-image: url('${pageHeaderImage}')` : undefined}
		>
			<div class="page_header_inner">
				{pageTitle && <h1 data-aos="fade-up" data-aos-duration="1500">{pageTitle}</h1>}
				{pageDescription && <p data-aos="fade-up" data-aos-duration="1800">{pageDescription}</p>}
			</div>
		</div>
	)}

	<PageContent
		page={page}
		showHeader={false}
		lang="en"
		notFoundTitle="Page not found"
		notFoundMessage="The requested page does not exist."
	/>
</BaseLayout>

<style>
	.partecipa_preheader {
		background: var(--grigio-chiaro);
	}

	.partecipa_preheader_inner {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 20px;
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		gap: 28px;
		align-items: start;
	}

	#block-hero-block-14-2 {
		min-width: 0;
	}

	#block-hero-block-14-2 :global(.hero_block) {
		margin: 0;
		max-width: 100%;
		flex-direction: column-reverse;
	}

	#block-hero-block-14-2 :global(.hero_button) {
		display: none !important;
	}

	.partecipa_preheader_form {
		min-width: 0;
	}

	.partecipa_preheader_form :global(.contact_form) {
		position: relative;
		margin-top: 22px;
	}

	.partecipa_preheader_form :global(.contact_form)::before {
		content: 'Reply within 24 hours';
		position: absolute;
		top: -14px;
		left: 20px;
		background: var(--primary);
		color: #fff;
		font-family: var(--font-heading);
		font-size: 18px;
		letter-spacing: 0.03em;
		padding: 6px 14px;
		border-radius: 999px;
		line-height: 1;
		z-index: 2;
	}

	@media (max-width: 980px) {
		.partecipa_preheader_inner {
			grid-template-columns: 1fr;
		}
	}
</style>
